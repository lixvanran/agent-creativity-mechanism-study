# -*- coding: utf-8 -*-
"""确定性结构化效用闸（filter，不是 scorer）。
刻意不做加权打分——加权会把「我的代理偏好」当成「质量」注入选择侧。
"""
import re
NUM = re.compile(r'\d+\s*(?:分|万|千|百|米|km|kg|圈|点|%|％|年|月|日|时|点|人|次|倍|倍|厘米|mm|℃|度)')
ENT = re.compile(r'(湖北|武大|华科|一本|特控|位次|专业组|转专业|保研|分数线|床头|前15位|第\d+圈|退赛|补交|认错|多血质|胆汁质|粘液质|抑郁质|单型|混合型|课堂|作业|清单)')
ACT = re.compile(r'(应当|应该|务必|先|再|最后|不要|别|至少|最多|定在|提前|安排|优先|放弃|选|挑|留在|跟|把)')
VAGUE = re.compile(r'(也许|可能吧|大概|一般来说|通常来讲|不一定|因人而异|见仁见智)')

def passes(text: str) -> bool:
    """是否含至少一条可核查的具体陈述（数字+单位 / 专名 / 明确动作）。
    这是过滤器不是打分器：只判有无，不比较优劣。"""
    if not text or len(text) < 30:
        return False
    concrete = bool(NUM.search(text)) or bool(ENT.search(text))
    actionable = bool(ACT.search(text))
    return concrete and actionable

def score_debug(text: str) -> dict:
    return dict(len=len(text), num=bool(NUM.search(text or '')),
                ent=bool(ENT.search(text or '')), act=bool(ACT.search(text or '')),
                vague=len(VAGUE.findall(text or '')), pass_gate=passes(text))
